NODE_ENV=development
PORT=4300
LOG_LEVEL=info

EMBEDDING_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=text-embedding-004

VECTOR_STORE=in-memory
