{
  "name": "@super-reasoning/backend",
  "private": true,
  "version": "3.2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "start": "tsx server/index.ts",
    "verify:scripts": "node scripts/verify-scripts.mjs",
    "typecheck": "tsc --noEmit",
    "test:run": "vitest run",
    "test:api:smoke": "vitest run server/lib/*.test.ts server/middleware/*.test.ts",
    "migrate:up": "tsx server/db/migrate.ts",
    "migrate:down": "tsx server/db/migrate.ts down",
    "db:setup": "tsx server/scripts/db-setup.ts",
    "db:seed": "tsx server/scripts/seed-default-org.ts",
    "seed:vectors": "tsx server/scripts/seed-vector-prompts.ts",
    "regression": "tsx server/scripts/run-regression-ci.ts",
    "regression:ci": "tsx server/scripts/run-regression-ci.ts --ci --fail-on-regression",
    "canary": "tsx server/scripts/run-canary.ts",
    "mcp:server": "tsx mcp/server.ts",
    "generate:api-key": "tsx server/scripts/generate-api-key.ts",
    "finetune:start": "tsx server/scripts/start-finetune.ts",
    "finetune:status": "tsx server/scripts/finetune-status.ts",
    "finetune:activate": "tsx server/scripts/finetune-activate.ts",
    "compose:dev:up": "docker compose -f docker-compose.dev.yml up -d",
    "compose:dev:down": "docker compose -f docker-compose.dev.yml down",
    "compose:dev:logs": "docker compose -f docker-compose.dev.yml logs -f --tail=200",
    "compose:vps:up": "docker compose -f docker-compose.vps.yml up -d",
    "compose:vps:build": "docker compose -f docker-compose.vps.yml up -d --build",
    "compose:vps:down": "docker compose -f docker-compose.vps.yml down"
  },
  "dependencies": {
    "@super-reasoning/shared": "*",
    "@anthropic-ai/claude-agent-sdk": "^0.2.42",
    "@anthropic-ai/sdk": "^0.74.0",
    "@google/adk": "^0.3.0",
    "@google/genai": "^1.38.0",
    "@openai/agents": "^0.4.10",
    "@supabase/supabase-js": "^2.49.0",
    "@types/multer": "^2.0.0",
    "@types/pdf-parse": "^1.1.5",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "esbuild": "^0.28.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "iyzipay": "^2.0.65",
    "jose": "^6.0.0",
    "js-yaml": "^4.1.1",
    "multer": "^2.1.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.13.0",
    "stripe": "^17.0.0",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.2",
    "@vitest/ui": "^4.0.18",
    "supertest": "^7.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^4.0.18"
  }
}
