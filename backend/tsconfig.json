{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "module": "ESNext",
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "types": ["node"],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": false,
    "strictNullChecks": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./*"],
      "@shared/*": ["../shared/*"],
      "@shared/types": ["../shared/types/index.ts"],
      "@/services/judgeEnsemble": ["../shared/services/judgeEnsemble"],
      "@/services/budgetOptimizer": ["../shared/services/budgetOptimizer"],
      "@/services/riskDiffAnalyzer": ["../shared/services/riskDiffAnalyzer"],
      "@/services/regressionRunner": ["../shared/services/regressionRunner"],
      "@/services/regressionRunnerLocal": ["../shared/services/regressionRunnerLocal"],
      "@/services/irExtractor": ["../shared/services/irExtractor"],
      "@/services/semanticCache": ["../shared/services/semanticCache"],
      "@/services/templateRecommendations": ["../shared/services/templateRecommendations"],
      "@/services/promptLifecycle": ["../shared/services/promptLifecycle"],
      "@/services/promptLifecycleLocal": ["../shared/services/promptLifecycleLocal"],
      "@/services/promptImprover": ["../shared/services/promptImprover"],
      "@/services/promptLint": ["../shared/services/promptLint"],
      "@/services/multiAgentOrchestrator": ["../shared/services/multiAgentOrchestrator"],
      "@/services/agentService": ["../shared/services/agentService"],
      "@/services/orchestrator": ["../shared/services/orchestrator"],
      "@/services/contractValidator": ["../shared/services/contractValidator"],
      "@/services/godModeValidator": ["../shared/services/godModeValidator"],
      "@/types": ["../shared/types/index.ts"],
      "@/types/*": ["../shared/types/*"],
      "@/types/framework": ["../../routing-service/src/domain/routing/types/framework"],
      "@/types/routing": ["../../routing-service/src/domain/routing/types/routing"],
      "@/lib/*": ["../shared/lib/*"],
      "@/utils/*": ["../shared/utils/*"],
      "@/data": ["../shared/data"],
      "@/data/*": ["../shared/data/*"],
      "@/locales/*": ["../shared/locales/*"]
    }
  },
  "include": [
    "server/**/*.ts",
    "mcp/**/*.ts",
    "cli/**/*.ts",
    "sdk/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "sk-service"
  ]
}
