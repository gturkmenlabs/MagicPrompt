{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "types": ["node", "vitest/globals", "vite/client", "react", "react-dom"],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": false,
    "strictNullChecks": true,
    "strictFunctionTypes": false,
    "strictBindCallApply": false,
    "noImplicitThis": false,
    "noUncheckedIndexedAccess": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["../shared/*"],
      "@shared/types": ["../shared/types/index.ts"],
      "@/types/framework": ["../routing-service/src/domain/routing/types/framework"],
      "@/types/routing": ["../routing-service/src/domain/routing/types/routing"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "*.ts", "*.d.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "playwright-report",
    "test-results",
    "src/services/agentService.ts",
    "src/services/agentTools.ts",
    "src/services/qwenAgentService.ts",
    "src/services/autonomousTasks.ts",
    "src/services/promptVersioning.ts"
  ]
}
